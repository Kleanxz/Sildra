# Copia estos valores a .env y conserva allí tu configuración de PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=sildra_support

# El administrador se crea o actualiza cuando inicia sesión con estas credenciales.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Correo de bienvenida enviado después del registro (SMTP). Usa credenciales de aplicación del proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
