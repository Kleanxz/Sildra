# Must match the agent server dispatch name (agent_name / agentName).
LIVEKIT_AGENT_NAME=SildraBot
# Shared only between this API and the LiveKit Builder HTTP tool. Keep it private.
SILDRA_KB_TOOL_KEY=replace-with-a-long-random-secret
